<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Labels and footers are keys into <lang>.lproj/Localizable.strings; "symbol"/"symbolColor" draw the row icon. -->
<plist version="1.0">
<dict>
	<key>title</key>
	<string>YouTubeX</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>GENERAL_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>ENABLE</string>
			<key>symbol</key>
			<string>power</string>
			<key>symbolColor</key>
			<string>#0A59F7</string>
			<key>key</key>
			<string>enabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.youtubex</string>
			<key>PostNotification</key>
			<string>com.anlai.youtubex/prefschanged</string>
		</dict>
		<!-- When to apply -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>ACTIVATION_TITLE</string>
			<key>footerText</key>
			<string>ACTIVATION_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>key</key>
			<string>activation</string>
			<key>default</key>
			<integer>0</integer>
			<key>validValues</key>
			<array>
				<integer>0</integer>
				<integer>1</integer>
			</array>
			<key>validTitles</key>
			<array>
				<string>ACTIVATION_CARPLAY</string>
				<string>ACTIVATION_ALWAYS</string>
			</array>
			<key>defaults</key>
			<string>com.anlai.youtubex</string>
			<key>PostNotification</key>
			<string>com.anlai.youtubex/prefschanged</string>
		</dict>
		<!-- Layout -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>LAYOUT_TITLE</string>
			<key>footerText</key>
			<string>LAYOUT_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>IPAD_LAYOUT</string>
			<key>symbol</key>
			<string>ipad.landscape</string>
			<key>symbolColor</key>
			<string>#8A47E8</string>
			<key>key</key>
			<string>ipadLayout</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.youtubex</string>
			<key>PostNotification</key>
			<string>com.anlai.youtubex/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>FORCE_LANDSCAPE</string>
			<key>symbol</key>
			<string>rotate.right.fill</string>
			<key>symbolColor</key>
			<string>#00A6B2</string>
			<key>key</key>
			<string>forceLandscape</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.anlai.youtubex</string>
			<key>PostNotification</key>
			<string>com.anlai.youtubex/prefschanged</string>
		</dict>
	</array>
</dict>
</plist>
